generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────── Blog ───────────────────────────

model BlogCategory {
  id     Int        @id @default(autoincrement())
  label  String
  accent String
  posts  BlogPost[]
}

model BlogPost {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  accent     String
  excerpt    String        @db.Text
  image      String
  timeAgo    String
  date       String
  content    String        @db.LongText
  href       String
  isFeatured Boolean       @default(false)
  isSidebar  Boolean       @default(false)
  categoryId Int?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Industry {
  id          Int         @id @default(autoincrement())
  label       String      @unique
  caseStudies CaseStudy[]
}

model ServiceArea {
  id          Int         @id @default(autoincrement())
  label       String      @unique
  caseStudies CaseStudy[] // implicit many-to-many
}

model CaseStudy {
  id           String @id @default(cuid())
  slug         String @unique
  heroTitle    String
  heroSubtitle String @db.Text
  heroImage    String

  industryId Int?
  industry   Industry? @relation(fields: [industryId], references: [id])

  serviceAreas ServiceArea[] // implicit many-to-many

  summary String @db.LongText // paragraphs separated by blank lines

  situationParagraphs String  @db.LongText // paragraphs separated by blank lines
  situationQuestions  String  @db.Text // one per line
  situationClosing    String? @db.Text

  challenge     String @db.LongText // paragraphs separated by blank lines
  approachIntro String @db.LongText // paragraphs separated by blank lines
  outcome       String @db.LongText // paragraphs separated by blank lines
  keyResults    String @db.Text // one per line

  calloutHeading     String?
  calloutText        String? @db.Text
  calloutButtonHref  String?
  calloutButtonLabel String?

  approachCards   ApproachCard[]
  timeline        TimelinePhase[]
  relatedServices RelatedService[]

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApproachCard {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  order       Int    @default(0)

  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

model TimelinePhase {
  id       Int    @id @default(autoincrement())
  phase    String
  duration String
  order    Int    @default(0)

  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

model RelatedService {
  id    Int    @id @default(autoincrement())
  label String
  href  String
  order Int    @default(0)

  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Newsletter ───────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─────────────────────────── Auth.js ───────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  password String? // bcrypt hash; null for OAuth-only users
  role     Role    @default(USER)

  accounts    Account[]
  sessions    Session[]
  posts       BlogPost[]
  caseStudies CaseStudy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}